{
  "name": "@oddjob/plugin-env-process",
  "version": "0.1.0",
  "description": "Oddjob plugin: trusted-local 'process' environment (Bun.spawn in tempdir).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsgo --noEmit",
    "build": "bunx tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@oddjob/core": "workspace:*",
    "@oddjob/sdk": "workspace:*"
  }
}
