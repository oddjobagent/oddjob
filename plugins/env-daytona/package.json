  "description": "Oddjob plugin: Daytona remote-VM environment (Firecracker-backed sandboxes with snapshot/fork/preview-URL caps).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
