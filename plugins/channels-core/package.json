{
  "name": "@oddjob/plugin-channels-core",
  "version": "0.0.0",
  "description": "Oddjob plugin: bundled core channels (console, slack, email, webhook)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsgo --noEmit",
    "build": "bunx tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@oddjob/channel-console": "workspace:*",
    "@oddjob/channel-email": "workspace:*",
    "@oddjob/channel-slack": "workspace:*",
    "@oddjob/channel-webhook": "workspace:*",
    "@oddjob/core": "workspace:*",
    "@oddjob/sdk": "workspace:*"
  }
}
