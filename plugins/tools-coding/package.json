{
  "name": "@oddjob/plugin-tools-coding",
  "version": "0.0.0",
  "description": "Oddjob plugin: coding tools (python_repl, javascript_repl)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
