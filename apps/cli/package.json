{
  "name": "@oddjob/cli",
  "version": "0.0.0",
  "description": "Oddjob CLI",
  "bin": {
    "oddjob": "./src/index.ts"
  },
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsgo --noEmit",
    "build": "bunx tsgo --build",
    "build:binary": "bun build --compile --outfile=./dist/oddjob ./src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.70.2",
    "@mariozechner/pi-ai": "^0.70.2",
    "@oddjob/agent": "workspace:*",
    "@oddjob/api-client": "workspace:*",
    "@oddjob/auth-local": "workspace:*",
    "@oddjob/channel-console": "workspace:*",
    "@oddjob/channel-email": "workspace:*",
    "@oddjob/channel-slack": "workspace:*",
    "@oddjob/channel-webhook": "workspace:*",
    "@oddjob/core": "workspace:*",
    "@oddjob/llm-pi": "workspace:*",
    "@oddjob/logging-sqlite": "workspace:*",
    "@oddjob/mcp-client": "workspace:*",
    "@oddjob/plugin-channels-core": "workspace:*",
    "@oddjob/plugin-env-daytona": "workspace:*",
    "@oddjob/plugin-env-docker": "workspace:*",
    "@oddjob/plugin-env-local-strict": "workspace:*",
    "@oddjob/plugin-env-process": "workspace:*",
    "@oddjob/plugin-llama-local": "workspace:*",
    "@oddjob/plugin-pi-models": "workspace:*",
    "@oddjob/plugin-tools-web-fetch": "workspace:*",
    "@oddjob/plugin-tools-web-search": "workspace:*",
    "@oddjob/queue-sqlite": "workspace:*",
    "@oddjob/scheduler-croner": "workspace:*",
    "@oddjob/sdk": "workspace:*",
    "@oddjob/secrets-sqlite": "workspace:*",
    "@oddjob/server": "workspace:*",
    "@oddjob/state-sqlite": "workspace:*",
    "ajv": "^8.17.1",
    "citty": "^0.1.6",
    "smol-toml": "^1.6.1",
    "typebox": "^1.1.33"
  }
}
