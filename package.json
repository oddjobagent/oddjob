{
  "name": "oddjob",
  "version": "0.0.0",
  "private": true,
  "description": "Task-specific AI agent runtime",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsgo --noEmit && bun run --cwd apps/dashboard typecheck",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "build": "bun run --filter '*' build",
    "clean": "bun run --filter '*' clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@types/bun": "latest",
    "@typescript/native-preview": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11"
}
